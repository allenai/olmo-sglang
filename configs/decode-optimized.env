# Measured second-pass H100/B300 decode setup. Tradeoffs and pinned runtime:
# docs/decode-composition.md
# Source before starting SGLang; restart the engine when changing these values.
# BF16 q/k alignment is part of this revision, not another configuration axis.
# KDA projection packing has a measured small-batch numerical cost on B300;
# all component switches retain their native alternatives documented above.
# Reproduce the measured automatic compatibility, rounding and tile selection.
unset OLMO_SGLANG_CORE_COMPAT OLMO_SGLANG_ROUNDING_KERNELS SGLANG_MOE_CONFIG_DIR
export OLMO_SGLANG_SHARED_ADD_NORM=fused
export OLMO_SGLANG_ROUTING_TAIL=fused
export OLMO_SGLANG_ROUTER_INPUT=fused
export OLMO_SGLANG_SAMPLER=fused
export OLMO_SGLANG_KDA_PROJECTIONS=packed
export OLMO_SGLANG_MOE_PROJECTIONS=packed
export OLMO_SGLANG_KDA_GATE_PROJECTIONS=grouped
export SGLANG_USE_PICKLE_IPC=false
# Optional additional throughput/numerical tradeoff: set this to fused after
# sourcing the file. It supersedes the routing-tail optimization above.
export OLMO_SGLANG_ROUTING_KERNELS=torch
